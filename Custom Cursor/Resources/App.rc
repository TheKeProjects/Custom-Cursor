#include <windows.h>
#include "Resource.h"
#include "Version.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

// Exe icon, selected by the mode flags in CustomCursor.vcxproj (the last enabled mode wins)
#if defined(CHRISTMAS_MODE)
IDI_APP ICON "../Assets/Icons/icon Christmas.ico"
#elif defined(HALLOWEEN_MODE)
IDI_APP ICON "../Assets/Icons/icon Halloween.ico"
#elif defined(SUMMER_MODE)
IDI_APP ICON "../Assets/Icons/icon Summer.ico"
#elif defined(LGBTQ_MODE)
IDI_APP ICON "../Assets/Icons/icon LGBTQ+.ico"
#else
IDI_APP ICON "../Assets/Icons/icon.ico"
#endif

// The window icon follows the theme chosen in the app
IDI_ICON_CLASSIC   ICON "../Assets/Icons/icon.ico"
IDI_ICON_LGBTQ     ICON "../Assets/Icons/icon LGBTQ+.ico"
IDI_ICON_SUMMER    ICON "../Assets/Icons/icon Summer.ico"
IDI_ICON_HALLOWEEN ICON "../Assets/Icons/icon Halloween.ico"
IDI_ICON_CHRISTMAS ICON "../Assets/Icons/icon Christmas.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
 PRODUCTVERSION APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", APP_AUTHORS
            VALUE "FileDescription", APP_DESCRIPTION
            VALUE "FileVersion", APP_VERSION_STRING
            VALUE "InternalName", APP_PRODUCT
            VALUE "OriginalFilename", APP_EXE_NAME
            VALUE "ProductName", APP_PRODUCT
            VALUE "ProductVersion", APP_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Everything under Assets\, Translations\, Cursores\ and Tutorial\ (generated by Tools\GenerateAssets.ps1 before each build)
#include "Generated/Assets.rc"

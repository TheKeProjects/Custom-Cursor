<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{99EF6941-6022-44D6-BB1D-73C5FB78AFC3}</ProjectGuid>
    <RootNamespace>CustomCursor</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <!-- No NuGet packages: don't pick up a project.assets.json left in obj\ by a .NET restore -->
    <ResolveNuGetPackages>false</ResolveNuGetPackages>
    <!-- Version, authors and description live in Resources\Version.h -->
  </PropertyGroup>

  <!-- Seasonal modes. Turn one on to change the exe icon and the default theme (the app's theme
       button overrides the theme, not the exe's icon). -->
  <PropertyGroup Label="AppInfo">
    <LgbtqMode>false</LgbtqMode>
    <SummerMode>false</SummerMode>
    <HalloweenMode>false</HalloweenMode>
    <ChristmasMode>true</ChristmasMode>
    <ModeDefines></ModeDefines>
    <ModeDefines Condition="'$(LgbtqMode)' == 'true'">$(ModeDefines);LGBTQ_MODE</ModeDefines>
    <ModeDefines Condition="'$(SummerMode)' == 'true'">$(ModeDefines);SUMMER_MODE</ModeDefines>
    <ModeDefines Condition="'$(HalloweenMode)' == 'true'">$(ModeDefines);HALLOWEEN_MODE</ModeDefines>
    <ModeDefines Condition="'$(ChristmasMode)' == 'true'">$(ModeDefines);CHRISTMAS_MODE</ModeDefines>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <!-- The updater downloads releases/latest/download/CustomCursor.exe (and the exe inside
         CustomCursorv<x-y-z>.zip): the name can't change. Keep APP_EXE_NAME in Resources\Version.h in sync -->
    <TargetName>CustomCursor</TargetName>
    <OutDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildProjectDirectory)\obj\$(Configuration)\</IntDir>
    <!-- Google Drive locks the link-time code generation's .ipdb (C1083 Permission denied): Release's intermediates stay off G: -->
    <IntDir Condition="'$(Configuration)' == 'Release'">$(LOCALAPPDATA)\CustomCursorBuild\obj\Release\</IntDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalIncludeDirectories>$(ProjectDir)Source;$(ProjectDir)Resources;$(ProjectDir)ThirdParty\WebView2\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>UNICODE;_UNICODE;WIN32_LEAN_AND_MEAN;NOMINMAX;_WIN32_WINNT=0x0A00$(ModeDefines);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalOptions>/utf-8 /bigobj /FS %(AdditionalOptions)</AdditionalOptions>
      <!-- C4100 unreferenced parameter, C4201 nameless struct (Windows headers) -->
      <DisableSpecificWarnings>4100;4201;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)Resources;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>UNICODE;_UNICODE$(ModeDefines);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <!-- asInvoker (C# default): installing / uninstalling asks for elevation only when it's needed,
           through a second copy of the exe started with "runas" (ElevatedInstaller) -->
      <UACExecutionLevel>AsInvoker</UACExecutionLevel>
      <AdditionalLibraryDirectories>$(ProjectDir)ThirdParty\WebView2\lib\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>WebView2LoaderStatic.lib;d2d1.lib;d3d11.lib;dxgi.lib;dwrite.lib;dcomp.lib;windowscodecs.lib;dwmapi.lib;winhttp.lib;ws2_32.lib;shlwapi.lib;shell32.lib;ole32.lib;advapi32.lib;crypt32.lib;bcrypt.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PreBuildEvent>
      <Command>powershell -NoProfile -ExecutionPolicy Bypass -File "$(ProjectDir)Tools\GenerateAssets.ps1" -ProjectDir "$(ProjectDir)."</Command>
      <Message>Generating the embedded asset list</Message>
    </PreBuildEvent>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Debug'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <!-- Only "CustomCursor.pdb" is written into the exe, not the full C:\Users\... path -->
      <AdditionalOptions>/PDBALTPATH:%_PDB% %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>

  <!-- Release: single self-contained exe (static CRT, assets embedded), deterministic, no PDB / debug info -->
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Release'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <DebugInformationFormat>None</DebugInformationFormat>
      <AdditionalOptions>/Brepro %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>false</GenerateDebugInformation>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <AdditionalOptions>/Brepro %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>

  <!-- Every source file under Source\ (folders are only for organisation) -->
  <ItemGroup>
    <ClCompile Include="Source\**\*.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="Source\**\*.h" />
    <ClInclude Include="Resources\*.h" />
  </ItemGroup>

  <ItemGroup>
    <ResourceCompile Include="Resources\App.rc" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="Resources\App.manifest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Tools\*.ps1" />
    <None Include="Translations\*.txt" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>

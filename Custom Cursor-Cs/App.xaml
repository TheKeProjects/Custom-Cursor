<Application x:Class="CustomCursor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>

        <!-- ===== Design tokens (MainWindow redesign) ===== -->

        <!-- Window backdrop -->
        <Color x:Key="BgTopColor">#FF1B1F27</Color>
        <Color x:Key="BgBottomColor">#FF272E3A</Color>

        <!-- Panels (header / side panels) -->
        <SolidColorBrush x:Key="PanelBrush" Color="#EA141821"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#14FFFFFF"/>

        <!-- Cards (scheme cards, preview cards, dialogs) -->
        <SolidColorBrush x:Key="CardBrush" Color="#F51E2330"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#3DFFFFFF"/>

        <!-- Accent (reuses the app's existing icy-blue identity) -->
        <Color x:Key="AccentLightColor">#88DDFF</Color>
        <Color x:Key="AccentDarkColor">#4499FF</Color>
        <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}"/>
        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6FC6F2" Offset="0"/>
            <GradientStop Color="#3D7DD8" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentBorderGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#88DDFF" Offset="0.25"/>
            <GradientStop Color="#4499FF" Offset="0.5"/>
            <GradientStop Color="#88DDFF" Offset="0.75"/>
            <GradientStop Color="#FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- Text -->
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F7FA"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AA5B1"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7480"/>

        <!-- Status -->
        <SolidColorBrush x:Key="DangerBrush" Color="#E5484D"/>
        <SolidColorBrush x:Key="DangerHoverBrush" Color="#F1666B"/>
        <SolidColorBrush x:Key="NeutralDisabledBrush" Color="#4B5563"/>

        <!-- Shared corner radii -->
        <CornerRadius x:Key="PanelRadius">14</CornerRadius>
        <CornerRadius x:Key="CardRadius">12</CornerRadius>
        <CornerRadius x:Key="ControlRadius">8</CornerRadius>

    </Application.Resources>
</Application>

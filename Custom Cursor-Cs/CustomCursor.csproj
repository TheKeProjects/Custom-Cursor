<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyName>CustomCursor</AssemblyName>
    <RootNamespace>CustomCursor</RootNamespace>
    <Version>2.0.0</Version>
    <Authors>An Average Developer</Authors>
    <Product>CustomCursor</Product>
    <Description>A tool for customizing Windows cursors</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embed icon as a compiled resource so the WPF Window.Icon (pack://application:,,,/icon.ico)
         resolves from inside the assembly. It must NOT also be declared as Content: WPF's pack
         resolver treats a file that's both Content and Resource as an "associated content file"
         first, which needs Assembly.Location - that's empty in single-file publish and throws. -->
    <Resource Include="icon.ico" />

    <!-- Copy Cursores folder and all contents to output directory -->
    <Content Include="Cursores\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Cursores\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>

    <!-- Copy tutorial folder and all contents to output directory -->
    <Content Include="Tutorial\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Tutorial\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

</Project>

<Window x:Class="CustomCursor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Cursor Manager" Height="846" Width="1285"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Icon="pack://siteoforigin:,,,/icon.ico"
        MinHeight="500" MinWidth="800">

    <Window.Resources>

        <!-- Secondary "glass" button - used for header actions, category list, back buttons -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource ControlRadius}"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="scaleTransform" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                            TextElement.FontFamily="Segoe UI Emoji"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource CardHoverBorderBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1.03" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1.03" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="0.96" Duration="0:0:0.05"/>
                                            <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="0.96" Duration="0:0:0.05"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav-list row (Categories sidebar) - flat row with a left accent bar when selected -->
        <Style x:Key="NavListButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0,9,8,9"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="rowBorder" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="rowBorder" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segment in the header's joined toolbar group -->
        <Style x:Key="SegmentButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="segBorder" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                            TextElement.FontFamily="Segoe UI Emoji"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="segBorder" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="segBorder" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary CTA button - gradient sheen border, used for the main "apply/install" actions -->
        <Style x:Key="ApplyButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="scaleTransform" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="outerBorder"
                                    BorderThickness="2"
                                    CornerRadius="9"
                                    BorderBrush="{StaticResource AccentBorderGradientBrush}">
                                <Border x:Name="border" Background="{TemplateBinding Background}"
                                        CornerRadius="7"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    TextElement.FontFamily="Segoe UI Emoji"/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1.02" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1.02" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="0.98" Duration="0:0:0.05"/>
                                            <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="0.98" Duration="0:0:0.05"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Search / filter text fields -->
        <Style x:Key="GlassTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,6,10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource ControlRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Row button used inside the Updates overlay (icon + title/subtitle, left aligned) -->
        <Style x:Key="UpdateRowButton" TargetType="Button">
            <Setter Property="Background" Value="#17FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="rowBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource ControlRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="rowBorder" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Margin="1"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Border Background="{StaticResource AccentLightBrush}"
                                                        CornerRadius="4"
                                                        Opacity="0.55"
                                                        Margin="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainGrid">
        <!-- Background will be set in code-behind for theme support -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource BgTopColor}" Offset="0"/>
                <GradientStop Color="{StaticResource BgBottomColor}" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Main View Panel -->
        <Grid x:Name="MainViewPanel" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1"
                    Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🖱️" FontSize="22" FontFamily="Segoe UI Emoji" Margin="0,0,10,0"
                                   VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Custom Cursor Manager" FontSize="19" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="VersionText" Text="v0.0.0" FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#17FFFFFF" BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <Grid>
                                <Button x:Name="CheckUpdatesButton" Content="🔄 Update" Style="{StaticResource SegmentButton}"
                                        ToolTip="Check for Updates" Click="CheckUpdatesButton_Click"/>
                                <Ellipse x:Name="UpdateAvailableBadge" Width="8" Height="8" Fill="{StaticResource DangerBrush}"
                                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,6,0"
                                         Visibility="Collapsed" IsHitTestVisible="False"/>
                            </Grid>
                            <Border Width="1" Margin="0,7" Background="{StaticResource PanelBorderBrush}"/>
                            <Button x:Name="TutorialButton" Content="📹 Tutorial" Style="{StaticResource SegmentButton}"
                                    ToolTip="Watch the tutorial" Click="TutorialButton_Click"/>
                            <Border Width="1" Margin="0,7" Background="{StaticResource PanelBorderBrush}"/>
                            <Button x:Name="WindowsSettingsButton" Content="⚙️ Settings" Style="{StaticResource SegmentButton}"
                                    ToolTip="Open Windows cursor settings" Click="WindowsSettingsButton_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Row="1" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Categories Panel (Left) -->
                <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource PanelRadius}" Margin="0,0,6,0" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="📁 Categories" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="4,0,0,12"/>

                        <TextBox x:Name="CategorySearchBox" Grid.Row="1" Style="{StaticResource GlassTextBox}"
                                 TextChanged="CategorySearchBox_TextChanged"/>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="CategoriesListPanel"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Cursor Schemes Panel (Right) -->
                <Border Grid.Column="1" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource PanelRadius}" Margin="6,0,0,0" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="SchemesHeaderText" Grid.Row="0" Text="🖱️ Cursor Schemes"
                                   FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="4,0,0,12"/>

                        <TextBox x:Name="SchemeSearchBox" Grid.Row="1" Style="{StaticResource GlassTextBox}"
                                 TextChanged="SchemeSearchBox_TextChanged"/>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <WrapPanel x:Name="SchemesWrapPanel" Orientation="Horizontal"
                                       HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        </ScrollViewer>

                        <Button x:Name="InstallSelectedButton" Grid.Row="3" Content="⚡ Install Selected"
                                Style="{StaticResource ApplyButton}" Height="42" Margin="0,12,0,0"
                                IsEnabled="False" Click="InstallSelectedButton_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Detailed Preview Panel -->
        <Grid x:Name="PreviewPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header with Back Button -->
            <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1"
                    Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BackFromPreviewButton" Grid.Column="0" Width="96" Height="38"
                            Style="{StaticResource ModernButton}" Margin="0,0,16,0"
                            Click="BackFromPreviewButton_Click" Padding="8">
                        <TextBlock Text="⬅️ Back" FontFamily="Segoe UI Emoji" TextAlignment="Center"/>
                    </Button>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="PreviewTitleText" Text="Cursor Scheme Preview"
                                   FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="PreviewPathText" Text=""
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Cursors Preview Area -->
            <Border Grid.Row="1" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource PanelRadius}" Margin="16" Padding="20">
                <ScrollViewer x:Name="PreviewScrollViewer" VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel x:Name="PreviewCursorsPanel" Orientation="Horizontal"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ScrollViewer>
            </Border>

            <!-- Apply Button -->
            <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                    Padding="16" Margin="16,0,16,16"
                    CornerRadius="{StaticResource PanelRadius}">
                <Button x:Name="ApplyPreviewButton" Content="✨ Apply This Cursor Scheme"
                        Style="{StaticResource ApplyButton}" Height="42" MaxWidth="440"
                        Click="ApplyPreviewButton_Click"/>
            </Border>
        </Grid>

        <!-- Tutorial Video Panel -->
        <Grid x:Name="TutorialPanel" Visibility="Collapsed" Background="Black">
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Back Button Overlay -->
            <Button x:Name="BackFromTutorialButton" Grid.Row="0" Content="⬅️ Back"
                    Style="{StaticResource ModernButton}" Width="96" Height="36"
                    Margin="15" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Click="BackFromTutorialButton_Click" Panel.ZIndex="10"/>

            <!-- Video Player -->
            <MediaElement x:Name="TutorialMediaPlayer" Grid.Row="1" Margin="0"
                          LoadedBehavior="Manual" UnloadedBehavior="Manual"
                          Stretch="Uniform" MediaEnded="TutorialMediaPlayer_MediaEnded"
                          MediaFailed="TutorialMediaPlayer_MediaFailed"
                          MouseLeftButtonDown="TutorialMediaPlayer_MouseLeftButtonDown"/>
        </Grid>

        <!-- Updates Overlay -->
        <Grid x:Name="UpdatesOverlay" Visibility="Collapsed" Background="#BB000000">
            <Border Width="620" Height="520" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource PanelRadius}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1"
                            CornerRadius="14,14,0,0"
                            Padding="20,14">
                        <TextBlock Text="🔄 Updates" FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Border>

                    <!-- CHECK VIEW -->
                    <ScrollViewer x:Name="UpdateCheckView" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,16">

                            <Button x:Name="CheckUpdatesBannerBtn" Style="{StaticResource UpdateRowButton}"
                                    Click="CheckUpdatesBanner_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔍" FontSize="22" FontFamily="Segoe UI Emoji" VerticalAlignment="Center"/>
                                    <StackPanel Margin="14,0,0,0">
                                        <TextBlock Text="Current version" FontSize="10.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="UpdateCurrentVersionText" Text="v0.0.0" FontSize="18"
                                                   FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="UpdateCheckHint" Text="Click to check again" FontSize="10.5"
                                                   FontStyle="Italic" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button x:Name="UpdateStatusBtn" Style="{StaticResource UpdateRowButton}"
                                    Visibility="Collapsed" Click="UpdateStatusBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="UpdateStatusIcon" Text="⬆️" FontSize="22"
                                               FontFamily="Segoe UI Emoji" VerticalAlignment="Center"/>
                                    <StackPanel Margin="14,0,0,0">
                                        <TextBlock x:Name="UpdateStatusTitle" FontSize="14.5" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="UpdateStatusMessage" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button x:Name="GbUpdateBtn" Style="{StaticResource UpdateRowButton}"
                                    Visibility="Collapsed" Click="GbUpdateBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🍌" FontSize="22" FontFamily="Segoe UI Emoji" VerticalAlignment="Center"/>
                                    <StackPanel Margin="14,0,0,0">
                                        <TextBlock x:Name="GbUpdateTitle" FontSize="14.5" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="GbUpdateMessage" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Border x:Name="UpdateDetailsBorder" Background="#17FFFFFF"
                                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource ControlRadius}" Padding="16,12" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="DETAILS" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Latest version" FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="UpdateLatestVersionText" Grid.Row="0" Grid.Column="1" FontSize="11.5"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="File" FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="UpdateFileNameText" Grid.Row="1" Grid.Column="1" FontSize="11.5"
                                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Size" FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="UpdateFileSizeText" Grid.Row="2" Grid.Column="1" FontSize="11.5"
                                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- INSTALL VIEW -->
                    <Grid x:Name="UpdateInstallView" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="20,16,20,10">
                            <TextBlock x:Name="InstallTitleText" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="InstallSubtitleText" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>

                        <Border Grid.Row="1" Background="#17FFFFFF" BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource ControlRadius}"
                                Margin="20,0,20,16" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="WHAT'S NEW" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="ChangelogText" FontSize="12.5"
                                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Footer -->
                    <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,14,14"
                            Padding="20,14">
                        <Grid>
                            <StackPanel x:Name="DownloadProgressPanel" Orientation="Horizontal"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="UpdateDownloadProgressText" Text="Downloading... 0%" FontSize="12"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <ProgressBar x:Name="UpdateDownloadProgressBar" Minimum="0" Maximum="100" Value="0"
                                             Width="200" Height="8" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel x:Name="InstallButtonsPanel" Orientation="Horizontal"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
                                <Button x:Name="AcceptInstallBtn" Content="⬇️ Update Now" Height="38" MinWidth="150"
                                        Style="{StaticResource ApplyButton}" Click="AcceptInstallBtn_Click"/>
                                <Button x:Name="CancelInstallBtn" Content="Cancel" Height="38" MinWidth="90"
                                        Style="{StaticResource ModernButton}" Margin="8,0,0,0"
                                        Click="CancelInstallBtn_Click"/>
                            </StackPanel>

                            <Button x:Name="CloseUpdatesBtn" Content="Close" Height="38" MinWidth="100"
                                    Style="{StaticResource ModernButton}" HorizontalAlignment="Right"
                                    Click="CloseUpdatesBtn_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

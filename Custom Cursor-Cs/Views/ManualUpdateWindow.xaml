<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CustomCursor.Views.ManualUpdateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:CustomCursor.Utilities"
    Title="Manual Update"
    WindowStartupLocation="CenterOwner"
    AllowsTransparency="True"
    WindowStyle="None"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Width="500" Height="420">

    <Window.Resources>
        <!-- Button style scoped to this window: dark theme + CornerRadius via ButtonHelper attached property -->
        <Style TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding Path=(local:ButtonHelper.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#EF07101A"
            BorderBrush="#153048" BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- ── Header ── -->
            <Border Grid.Row="0" Background="#05090F"
                    BorderBrush="#0D2030" BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#00CCAA"
                                 Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="HeaderText"
                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="13" FontWeight="Bold" Foreground="#00CCAA"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Click="Close_Click"
                            Width="28" Height="28"
                            HorizontalAlignment="Right"
                            local:ButtonHelper.CornerRadius="4"
                            Background="#0A1825" BorderBrush="#0D2535"
                            BorderThickness="1" Cursor="Hand">
                        <TextBlock Text="✕" FontSize="12" FontWeight="Bold"
                                   Foreground="#3A6A8A"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ── Content ── -->
            <StackPanel Grid.Row="1" Margin="20,16">
                <TextBlock x:Name="IntroText"
                           FontFamily="Cascadia Code, Consolas, Courier New"
                           FontSize="11" Foreground="#8AABBD"
                           TextWrapping="Wrap" Margin="0,0,0,14"/>

                <Border x:Name="StatusBorder"
                        Background="#060F18" BorderBrush="#0D2535" BorderThickness="1"
                        CornerRadius="4" Padding="16,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StatusIcon"
                                   FontFamily="Segoe MDL2 Assets" Text="&#xE895;"
                                   FontSize="22" Foreground="#00CCAA"
                                   VerticalAlignment="Center"/>
                        <StackPanel Margin="14,0,0,0">
                            <TextBlock x:Name="StatusTitleText"
                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                       FontSize="14" FontWeight="Bold" Foreground="#00CCAA"/>
                            <TextBlock x:Name="StatusMessageText"
                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                       FontSize="11" Foreground="#8AABBD" Opacity="0.9"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="DownloadProgressPanel"
                            Orientation="Horizontal"
                            Visibility="Collapsed" Margin="2,14,0,0">
                    <TextBlock x:Name="DownloadProgressText"
                               FontFamily="Cascadia Code, Consolas, Courier New"
                               FontSize="11" Foreground="#00CCAA"
                               VerticalAlignment="Center"/>
                    <ProgressBar x:Name="DownloadProgressBar"
                                 Value="0" Maximum="100"
                                 Width="220" Height="6" VerticalAlignment="Center"
                                 Margin="12,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- ── Footer ── -->
            <Border Grid.Row="2" Background="#060F18"
                    BorderBrush="#0D2030" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                    <Button x:Name="DownloadBtn"
                            Height="36" MinWidth="220"
                            local:ButtonHelper.CornerRadius="3"
                            Background="#00CCAA" BorderThickness="0"
                            Click="DownloadBtn_Click">
                        <TextBlock x:Name="DownloadBtnText"
                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="11" FontWeight="Bold" Foreground="#060C12"/>
                    </Button>
                    <Button x:Name="BrowserBtn"
                            Height="36" MinWidth="140"
                            local:ButtonHelper.CornerRadius="3"
                            Background="#0A1825" BorderBrush="#0D2535" BorderThickness="1"
                            Click="BrowserBtn_Click"
                            Margin="8,0,0,0">
                        <TextBlock x:Name="BrowserBtnText"
                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="11" FontWeight="Bold" Foreground="#3A6A8A"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
